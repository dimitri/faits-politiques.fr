{{define "content"}}
<p class="fil"><a href="{{.Root}}/">Accueil</a> ›
  {{if .Cand}}<a href="{{.Root}}/candidats/">Candidats 2027</a>
  {{else}}<a href="{{.Root}}/assemblee/">Assemblée nationale</a>{{end}} ›
  <span>{{.P.Prenom}} {{.P.Nom}}</span></p>

<div class="entete-portrait" style="margin-top:.6rem">
  {{if and .Cand .Cand.Portrait}}<img src="{{.Root}}/media/{{.Cand.Portrait.Fichier}}"
    alt="Portrait de {{.P.Prenom}} {{.P.Nom}}" width="104" height="104" loading="lazy"
    style="object-fit:cover">{{end}}
  <div style="flex:1;min-width:16rem">
    {{if .P.Mandat}}<span class="sur">{{.P.Mandat}}</span>{{end}}
    <h1 style="margin-top:0">{{.P.Prenom}} {{.P.Nom}}</h1>
    {{if .P.Groupe}}<p class="muted" style="margin:.4rem 0 0;font-size:.95rem">{{.P.Groupe}}</p>{{end}}
    {{if and .Cand .Cand.Portrait}}<p class="small muted" style="margin:.5rem 0 0">Portrait&nbsp;:
      {{.Cand.Portrait.Licence}}{{if .Cand.Portrait.Auteur}}, {{.Cand.Portrait.Auteur}}{{end}} —
      <a href="{{.Cand.Portrait.SourceURL}}" target="_blank" rel="noopener">Wikimedia Commons</a></p>{{end}}
  </div>
  <div class="actions" style="margin:0">
    <button type="button" class="btn" data-copier="url" hidden>Copier le lien</button></div>
</div>

{{if .Cand}}<p class="lede">Candidat déclaré à l'élection présidentielle de 2027 pour
{{if .Cand.Org}}<a href="{{.Root}}/organisation/{{.Cand.Org.Slug}}/">{{.Cand.Organisation}}</a>{{else}}{{.Cand.Organisation}}{{end}}{{if .Cand.DateDeclaration}}, déclaré le {{.Cand.DateDeclaration}}{{end}}.
<span class="small">Source&nbsp;: <a href="{{.Cand.SourceURL}}">déclaration publique</a>,
consultée le {{.Cand.SourceConsultee}}.</span></p>{{end}}

{{if .Cand}}
{{/* Ce que le site sait d'un candidat qui n'a jamais siégé au Parlement. Sans
     ce bloc, une fiche comme celle de Nathalie Arthaud était vide — et une page
     vide se lit comme « cette personne n'a rien fait », ce qui est faux : elle
     décrit le périmètre du site, pas la personne. */}}
<h2 style="margin-top:2.2rem">Ce que le site sait, et d'où</h2>
<div class="angles">
  <div class="angle{{if not .P.HasVotes}} vide{{end}}"><div class="t">Votes au Parlement</div>
    {{if .P.HasVotes}}<div class="v">{{nb .P.Exprimes}}</div>
      <div class="d">positions exprimées, détaillées plus bas</div>
    {{else}}<div class="v">n'a pas siégé dans une assemblée couverte par ce site</div>{{end}}</div>

  <div class="angle{{if not (and .Local (eq .Local.Statut "RETENU"))}} vide{{end}}">
    <div class="t">Mandats locaux</div>
    {{if and .Local (eq .Local.Statut "RETENU")}}<div class="v">{{len .Local.Mandats}}</div>
      <div class="d">en cours au répertoire national des élus</div>
    {{else if .Local}}<div class="v">aucun mandat local rattaché — voir la note ci-dessous</div>
    {{else}}<div class="v">aucun rapprochement avec le répertoire national des élus</div>{{end}}</div>

  <div class="angle{{if not (and .K .K.Comptes.Present)}} vide{{end}}">
    <div class="t">Comptes du parti</div>
    {{if and .K .K.Comptes.Present}}<div class="v">{{.K.Exercices}}</div>
      <div class="d">exercices déposés à la CNCCFP{{if .Cand.Org}} par
        <a href="{{$.Root}}/organisation/{{.Cand.Org.Slug}}/">{{.Cand.Organisation}}</a>{{end}}</div>
    {{else if .K}}<div class="v">{{.K.Comptes.Raison}}</div>
    {{else}}<div class="v">non renseigné</div>{{end}}</div>

  <div class="angle{{if not (and .K .K.Interets.Present)}} vide{{end}}">
    <div class="t">Intérêts déclarés</div>
    {{if and .K .K.Interets.Present}}<div class="v">{{nb .K.NbInterets}}</div>
      <div class="d">lignes de déclaration HATVP</div>
    {{else if .K}}<div class="v">{{.K.Interets.Raison}}</div>
    {{else}}<div class="v">non renseigné</div>{{end}}</div>
</div>

{{if .Local}}
<p class="note {{if eq .Local.Statut "RETENU"}}proc{{else}}abs{{end}}">
  {{if eq .Local.Statut "RETENU"}}<strong>Les mandats locaux ci-dessous viennent d'un rapprochement
  fait par ce site</strong>, pas d'un identifiant commun aux deux sources&nbsp;: le répertoire des
  élus et la liste des candidats n'en partagent aucun. Vérification retenue&nbsp;:
  {{.Local.Verification}}.{{if .Local.Source}} <a href="{{.Local.Source}}" target="_blank"
  rel="noopener">Source</a>.{{end}}
  {{else}}<strong>Aucun mandat local n'est rattaché à cette fiche, et c'est un choix.</strong>
  {{.Local.Verification}}. Un rapprochement automatique sur «&nbsp;un seul homonyme&nbsp;» aurait
  produit un faux sur cette page&nbsp;; la décision est consignée dans
  <code>data/candidats-mandats-locaux.csv</code>.{{end}}
</p>
{{end}}

{{if and .Local (eq .Local.Statut "RETENU") .Local.Mandats}}
<div class="scroll"><table class="pile">
<thead><tr><th>Mandat</th><th>Fonction</th><th>Où</th><th>Depuis</th></tr></thead>
<tbody>{{range .Local.Mandats}}<tr>
  <td data-l="Mandat"><b>{{.Type}}</b></td>
  <td class="small z" data-l="Fonction">{{if .Role}}{{.Role}}{{else}}—{{end}}</td>
  <td class="small" data-l="Où">{{if .Lieux}}{{template "lieux" .Lieux}}{{else if .Lieu}}{{.Lieu}}{{else}}<span class="z">non publié</span>{{end}}</td>
  <td class="small z" data-l="Depuis">{{.Depuis}}</td>
</tr>{{end}}</tbody></table></div>
{{end}}

{{if and .K .K.Terrain.Present (not .K.Apercu.Vide)}}
<h2>Où son parti a recueilli des voix</h2>
<div class="une-carte">
  <a href="{{.Root}}/2027/{{.K.Page.Slug}}/">{{.K.Apercu.SVG}}</a>
  <div>
    <p>Part des voix obtenues aux municipales de 2026, premier tour, par les listes que le ministère
    de l'Intérieur range sous la nuance <code>{{.K.NuanceCode}}</code>, rapportée aux
    <strong>seules listes nuancées</strong>. {{nb .K.CommunesListes}} communes,
    {{nb .K.SiegesCM}} sièges, {{nb64 .K.VoixMunicipales}} voix.</p>
    {{template "cartons" .K.Apercu.Cartons}}
    {{$t := .K.Apercu.Teintes}}<div class="echelle"><span class="u">{{.K.Apercu.Unite}}</span>
      {{range $i, $b := .K.Apercu.Bornes}}<span><i style="background:{{index $t $i}}"></i>{{$b}}</span>{{end}}</div>
    <p class="small muted"><strong>Le score d'un parti n'est pas celui de son candidat.</strong>
    Une municipale se joue sur des listes locales, souvent d'union, en 2026. Le rattachement de la
    nuance au parti est une décision de ce site, consignée dans
    <code>data/nuance-partis.csv</code>. <a href="{{.Root}}/2027/{{.K.Page.Slug}}/">La carte en
    grand et le classement →</a></p>
  </div>
</div>
{{.Defs}}
{{end}}
{{end}}

<h2 style="margin-top:2.2rem">Mandats</h2>
{{if .P.Mandats}}
<div class="scroll"><table class="pile">
<thead><tr><th>Mandat</th><th>Fonction</th><th>Où</th><th>Période</th>
  <th>Président en fonction</th></tr></thead>
<tbody>{{range .P.Mandats}}<tr>
  <td><b>{{libMandat .Type}}</b></td>
  <td class="small z" data-l="Fonction">{{if .Role}}{{.Role}}{{else}}—{{end}}</td>
  <td class="small" data-l="Où">{{if .Lieux}}{{template "lieux" .Lieux}}{{else if .Portefeuille}}{{.Portefeuille}}{{else if .Circo}}{{.Circo}}{{else}}<span class="z">non publié par la source</span>{{end}}</td>
  <td class="small z" data-l="Période">{{.Periode}}</td>
  <td class="small z" data-l="Président">{{if .SousPresidence}}{{.SousPresidence}}{{else}}—{{end}}</td>
</tr>{{end}}</tbody></table></div>
<p class="note">Les fonctions et portefeuilles sont repris <strong>tels que publiés</strong> par
l'Assemblée, sans normalisation. Un mandat ministériel figure ici parce qu'il est publié dans le
même référentiel&nbsp;; il ne relève pas de l'activité parlementaire — et c'est précisément pour
cela qu'il fausserait un taux de participation. La colonne «&nbsp;président en fonction&nbsp;» est
un <strong>repère chronologique</strong>, pas une imputation&nbsp;: un ministre n'est pas
responsable des actes du président, ni l'inverse.</p>
{{else}}<p class="nodata">Aucun mandat dans le périmètre couvert (Assemblée nationale,
17<sup>e</sup> législature).</p>{{end}}

{{if .P.HasVotes}}
{{/* Les mandats passent devant : ils disent QUI siège, et à quel titre. Le
     bilan de vote qui suit ne se lit pas sans eux — « 312 positions exprimées »
     ne veut rien dire tant qu'on ignore pendant quelle législature, ni si la
     personne a été ministre au milieu. Le taux de participation, lui, n'est
     pas affiché : voir la carte d'absence typée. */}}
<h2>{{nb .P.Exprimes}} positions exprimées</h2>
<div style="display:grid;gap:1.6rem;grid-template-columns:repeat(auto-fit,minmax(19rem,1fr));
  align-items:start;margin-top:1.2rem">
  <div>
    <div class="bar" style="height:26px" role="img"
         aria-label="{{.P.Pour}} pour, {{.P.Contre}} contre, {{.P.Abstention}} abstentions">
      <i style="width:{{pct .P.Pour .P.Exprimes}}%;background:var(--pour)"></i>
      <i style="width:{{pct .P.Contre .P.Exprimes}}%;background:var(--contre)"></i>
      <i style="width:{{pct .P.Abstention .P.Exprimes}}%;background:var(--abst)"></i></div>
    <div class="seuil-lg" style="margin-top:1rem">
      <span style="color:var(--encre)"><i style="background:var(--pour)"></i>
        <b>{{nb .P.Pour}}</b>&nbsp;pour</span>
      <span style="color:var(--encre)"><i style="background:var(--contre)"></i>
        <b>{{nb .P.Contre}}</b>&nbsp;contre</span>
      <span style="color:var(--encre)"><i style="background:var(--abst)"></i>
        <b>{{nb .P.Abstention}}</b>&nbsp;abstentions</span>
      <span><i style="background:transparent;border:1.5px solid var(--absent)"></i>
        {{nb .P.NonVotant}} non-votant{{if gt .P.NonVotant 1}}s{{end}}</span>
    </div>
    <p class="note">Cette répartition porte sur les positions <em>exprimées</em>. Elle ne mesure ni
    une ligne politique ni une proximité&nbsp;: un vote contre peut viser le véhicule législatif, le
    calendrier, ou un texte concurrent préféré. «&nbsp;Non-votant&nbsp;» n'est pas une position
    politique&nbsp;: c'est une donnée manquante, et elle n'entre dans aucun calcul.</p>
  </div>

  {{/* Le site affichait ici « N sur 8 434 scrutins (X %) », rapporté au total de
       TOUTE la législature. Pour quiconque n'a pas siégé sur toute la période —
       ou fut ministre, période pendant laquelle un député ne vote pas — le
       dénominateur est faux, et le chiffre se lit comme un score d'assiduité.
       Un score est un verdict : principe n° 1. On publie donc le numérateur, et
       on type l'absence — principe n° 2. */}}
  <div class="carte creuse">
    <span class="t">Taux de participation&nbsp;: non calculé</span>
    <span class="d" style="margin-top:.5rem">Le calculer exige de connaître le nombre de scrutins
    <strong>tenus pendant les mandats effectifs</strong> de cette personne, en excluant toute
    période de fonction gouvernementale — un ministre ne vote pas. Ce dénominateur n'est pas
    encore dérivé, et le rapporter au total de la législature produirait un score d'assiduité
    faux.</span>
    <span class="d" style="margin-top:.6rem">Raison de l'absence&nbsp;:
      <code>DENOMINATEUR_NON_BORNE</code></span>
  </div>
</div>

<h2>Comment a-t-il voté</h2>
{{if .P.Votes}}
<div class="filtre" data-filtre="votes-personne">
  <input type="search" placeholder="Filtrer par objet…" aria-label="Filtrer par objet">
  <button type="button" class="puce" aria-pressed="true">Tous</button>
  <button type="button" class="puce" data-g="Pour">Pour</button>
  <button type="button" class="puce" data-g="Contre">Contre</button>
  <button type="button" class="puce" data-g="Abstention">Abstention</button>
</div>
<p class="small muted"><span data-compte>{{.P.VotesShown}}</span> scrutins affichés sur
  {{nb .P.Exprimes}} positions exprimées&nbsp;: la liste est bornée, et la troncature est visible
  plutôt que silencieuse.</p>
<div class="scroll"><table class="pile pile-1" id="votes-personne">
<thead><tr><th>Date</th><th>Objet</th><th>Position</th><th>Résultat</th></tr></thead>
<tbody>{{range .P.Votes}}<tr data-g="{{.PositionFr}}">
  <td class="small z" style="white-space:nowrap">{{.Date}}</td>
  <td data-l="Objet"><a href="{{$.Root}}/scrutin/{{.Slug}}/">{{.Objet}}</a></td>
  <td data-l="Position"><span class="pastille {{.Position}}">{{.PositionFr}}</span></td>
  <td class="small z" data-l="Résultat">{{.Resultat}}</td>
</tr>{{end}}</tbody></table></div>
<p class="note abs">Le filtre est purement local&nbsp;: aucune requête, le site reste statique. Il
ne porte que sur les scrutins affichés ci-dessus, pas sur l'ensemble des positions exprimées.</p>
{{else}}<p class="nodata">Aucun vote chargé pour cette personne.</p>{{end}}
{{else}}
<p class="nodata" style="margin-top:1.6rem">Aucun vote dans le périmètre couvert. Cela décrit
<strong>le périmètre de ce site</strong>, pas l'activité de la personne&nbsp;: un élu peut siéger
au Sénat, au Parlement européen, dans une collectivité, ou n'avoir jamais eu de mandat
parlementaire.</p>
{{end}}

{{if .P.Affiliations}}
<details class="plus">
  <summary>Appartenances déclarées ({{len .P.Affiliations}})</summary>
  <div class="dedans">
    <div class="scroll"><table class="pile">
    <thead><tr><th>Organisation</th><th>Nature</th><th>Période</th><th>Comment on le sait</th></tr></thead>
    <tbody>{{range .P.Affiliations}}<tr>
      <td>{{.Nom}}</td><td class="small z" data-l="Nature">{{.Kind}}</td>
      <td class="small z" data-l="Période">{{.Periode}}</td>
      <td class="small z" data-l="Source">{{.Via}}</td>
    </tr>{{end}}</tbody></table></div>
    <p class="note">L'appartenance à un groupe parlementaire est publiée par l'Assemblée. Le
    rattachement à un parti figurant dans ce même fichier est <strong>déclaratif</strong>&nbsp;: il
    n'a pas la valeur du rattachement publié au Journal officiel en décembre au titre de l'aide
    publique, qui n'est pas encore ingéré.</p>
  </div>
</details>
{{end}}

<details class="plus" open>
  <summary>Ce que cette fiche ne dit pas</summary>
  <div class="dedans">
    <p class="note">Elle décrit <strong>le périmètre de ce site</strong>, pas l'activité de la
    personne&nbsp;: travail en commission, rapports, questions au Gouvernement et votes à main levée
    n'y figurent pas. Une fiche vide ne dit rien de son travail, de son influence ni de sa
    légitimité.</p>
    <p class="note"><strong>Aucun classement, aucune note, aucun score de proximité</strong> n'est
    produit&nbsp;: le site refuse de les calculer, et pas seulement de les afficher.</p>
    <p class="note">Seuls les scrutins <em>publics</em> sont couverts. La majorité des votes ont
    lieu à main levée et ne laissent aucune trace nominative.</p>
  </div>
</details>
{{end}}
