{{define "base"}}<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="{{.Root}}/media/logo-mark.svg" type="image/svg+xml">
<title>{{.Title}} — faits-politiques.fr</title>
<link rel="stylesheet" href="{{.Root}}/{{.CSS}}">
<script>
// Appliqué avant le premier rendu : sans cela la page clignote du thème
// système au thème choisi. Trois états — système, clair, sombre — et le choix
// ne quitte jamais le navigateur.
try{var t=localStorage.getItem('fp-theme');
if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}
</script>
</head><body>
<a class="saut" href="#contenu">Aller au contenu</a>

<header class="top"><div class="wrap"><div class="row">
  {{/* Le logo est un fichier, plus un SVG en ligne : ses seize cases pesaient
       1,8 Ko sur chacune des 77 000 pages, soit 140 Mo de la même image. Le
       fichier est déjà servi comme favicon, donc déjà en cache. */}}
  <a class="marque" href="{{.Root}}/"><img src="{{.Root}}/media/logo-mark.svg" width="30" height="30" alt=""><span class="mot">faits-politiques<i>.fr</i></span></a>
  <button type="button" class="rech compact" data-rech hidden>
    {{ico "loupe"}}<span class="txt">Rechercher un candidat, un parti, un sujet…</span><kbd>/</kbd></button>
  <div class="theme" role="group" aria-label="Thème de couleur" hidden>
    <button type="button" data-theme-set="auto" title="Suivre le système"
      aria-label="Suivre le système">{{ico "systeme"}}</button>
    <button type="button" data-theme-set="light" title="Thème clair"
      aria-label="Thème clair">{{ico "soleil"}}</button>
    <button type="button" data-theme-set="dark" title="Thème sombre"
      aria-label="Thème sombre">{{ico "lune"}}</button>
  </div>
  {{/* Cinq entrées, par question du lecteur (proposition d'accueil du
       15 septembre 2026) : la présidentielle d'abord, raison d'être du site,
       puis les sujets dont parlent les candidats, l'argent public qui les
       finance, les institutions qui en décident, et d'où viennent les chiffres. */}}
  <nav>
    <a href="{{.Root}}/2027/">{{ico "candidats"}}2027</a>
    <a href="{{.Root}}/sujets/">{{ico "themes"}}Sujets</a>
    <a href="{{.Root}}/argent-public/">{{ico "budget"}}Argent public</a>
    <a href="{{.Root}}/qui-decide/">{{ico "assemblee"}}Qui décide</a>
    <a href="{{.Root}}/sources/">{{ico "sources"}}Sources</a>
  </nav>
</div></div></header>

{{if .Hero}}<section class="hero">
  <div class="champ" aria-hidden="true"></div>
  <div class="wrap">
    <h1>{{.HeroTitre}}</h1>
    <p class="lede">{{.HeroLede}}</p>
    <div class="outil">
      <button type="button" class="rech grand" data-rech hidden>
        {{ico "loupe"}}<span class="txt">Un candidat, un sujet, un parti…</span><kbd>/</kbd></button>
      <div class="suggest">
        <span>Par exemple&nbsp;:</span>
        <a href="{{.Root}}/sujets/retraites/">Retraites</a>
        <a href="{{.Root}}/argent-public/dette/">Dette publique</a>
        <a href="{{.Root}}/sujets/sante/">Santé</a>
        <a href="{{.Root}}/sujets/police/">Police</a>
        <a href="{{.Root}}/sujets/immigration/">Immigration</a>
        <a href="{{.Root}}/candidats/">Candidats 2027</a>
      </div>
    </div>
    <dl class="ancrage">
      <div><dt>Données arrêtées au</dt><dd>{{.DerniereIngestion}}</dd></div>
      <div><dt>Documents scellés</dt><dd>{{nb .Cov.Documents}}, empreinte SHA-256</dd></div>
      <div><dt>Reconstruction</dt><dd>intégrale depuis l'archive brute</dd></div>
      <div><dt>Vérifier</dt><dd><a href="{{.Root}}/sources/">Sources, licences et dates →</a></dd></div>
    </dl>
  </div>
</section>{{end}}

<main class="wrap" id="contenu">
{{template "content" .}}
</main>

<nav class="tabbar" aria-label="Navigation principale">
  <a href="{{.Root}}/2027/">{{ico "candidats"}}2027</a>
  <a href="{{.Root}}/sujets/">{{ico "themes"}}Sujets</a>
  <a href="{{.Root}}/argent-public/">{{ico "budget"}}Argent</a>
  <a href="{{.Root}}/qui-decide/">{{ico "assemblee"}}Décide</a>
  <a href="{{.Root}}/sources/">{{ico "sources"}}Sources</a>
  <button type="button" data-rech hidden>{{ico "loupe"}}Chercher</button>
</nav>

<footer class="pied"><div class="wrap">
  <div class="cols">
    <div><h4>2027</h4><ul>
      <li><a href="{{.Root}}/2027/">Présidentielle 2027</a></li>
      <li><a href="{{.Root}}/candidats/">Candidats déclarés</a></li>
      <li><a href="{{.Root}}/partis/">Partis et comptes publics</a></li>
      <li><a href="{{.Root}}/frise/">La V<sup>e</sup> République en chiffres</a></li>
    </ul></div>
    <div><h4>Sujets</h4><ul>
      <li><a href="{{.Root}}/sujets/">Tous les sujets</a></li>
      <li><a href="{{.Root}}/sujets/retraites/">Retraites</a></li>
      <li><a href="{{.Root}}/sujets/sante/">Santé</a></li>
      <li><a href="{{.Root}}/sujets/chomage/">Chômage</a></li>
      <li><a href="{{.Root}}/sujets/education/">Éducation</a></li>
      <li><a href="{{.Root}}/sujets/police/">Police et délinquance</a></li>
      <li><a href="{{.Root}}/sujets/immigration/">Immigration</a></li>
      <li><a href="{{.Root}}/sujets/collectivites/">Collectivités</a></li>
    </ul></div>
    <div><h4>Argent public</h4><ul>
      <li><a href="{{.Root}}/argent-public/">Où va l'argent public</a></li>
      <li><a href="{{.Root}}/budget/">Budget de l'État</a></li>
      <li><a href="{{.Root}}/protection-sociale/">Protection sociale</a></li>
      <li><a href="{{.Root}}/dette/">Dette publique</a></li>
      <li><a href="{{.Root}}/dividendes/">Dividendes</a></li>
    </ul></div>
    <div><h4>Qui décide</h4><ul>
      <li><a href="{{.Root}}/gouvernement/">Gouvernement</a></li>
      <li><a href="{{.Root}}/assemblee/">Assemblée nationale</a></li>
      <li><a href="{{.Root}}/senat/">Sénat</a></li>
      <li><a href="{{.Root}}/europe/">Parlement européen</a></li>
      <li><a href="{{.Root}}/themes/">Thèmes des lois</a></li>
    </ul></div>
    <div><h4>Sources</h4><ul>
      <li><a href="{{.Root}}/sources/">Les {{nb .Cov.Documents}} documents scellés</a></li>
      <li><a href="{{.Root}}/comprendre/">Documents de méthode</a></li>
      <li><a href="{{.Root}}/comprendre/perimetre/">Principes et périmètre</a></li>
      <li>Code sous AGPL-3.0, données sous Licence Ouverte</li>
    </ul>
      <p style="margin-top:.8rem">Données arrêtées au <strong>{{.DerniereIngestion}}</strong>.
      Site reconstruit le {{.BuiltAt}}, <strong>intégralement</strong> depuis l'archive brute.</p></div>
  </div>
  <p class="bas" style="border-top:1px solid var(--filet);margin-top:2rem;padding-top:1.2rem">
    Typographie&nbsp;: IBM&nbsp;Plex Sans et Mono, Newsreader — <abbr title="SIL Open Font License 1.1">OFL&nbsp;1.1</abbr>.
    Icônes&nbsp;: <a href="https://fontawesome.com/license/free" target="_blank" rel="noopener">Font
    Awesome Free 6.7.2</a>, <abbr title="Creative Commons Attribution 4.0">CC&nbsp;BY&nbsp;4.0</abbr>.
    Les trois sont hébergées en propre&nbsp;: ce site ne fait aucune requête vers un tiers.</p>
  <p class="bas" style="border:0;margin-top:0;padding-top:0">Sources primaires&nbsp;:
    {{range $i, $s := .Sources}}{{if $i}} · {{end}}{{$s.Attribution}}{{end}}.
    Dans la limite des licences amont.
    <a href="{{.Root}}/sources/">Le détail, avec dates de consultation et empreintes SHA-256 →</a></p>
</div></footer>

<dialog class="palette" id="palette" aria-label="Rechercher">
  <div class="boite">
    <div class="champ">{{ico "loupe"}}
      <input type="search" id="q" placeholder="Un nom, un parti, un groupe…"
             autocomplete="off" spellcheck="false" aria-label="Rechercher"></div>
    <div class="res" id="res"></div>
    <p class="pied-p" style="margin:0"><strong>Les scrutins ne sont pas encore indexés.</strong>
      L'index couvre les personnes, les partis, les groupes et les référentiels.
      Code de non-couverture&nbsp;: <code>SEARCH_INDEX_PARTIEL</code>.</p>
  </div>
</dialog>

<script src="{{.Root}}/{{.JS}}" defer></script>
</body></html>{{end}}

{{/* Le bloc « un décret, tel qu'il a paru » sert à deux pages : l'entrée
     Gouvernement, qui en montre vingt, et la page qui les montre tous. Il vit
     ici parce que chaque page n'est analysée qu'avec base.gohtml. */}}
{{define "decrets"}}{{$root := .Root}}{{range .Decrets}}
<section class="bloc decret">
  <div class="tete"><div>
    <span class="sur">{{.Date}}</span>
    <h3 style="margin:.1rem 0 0">{{if .Titre}}{{.Titre}}{{else}}Décret relatif à la composition du Gouvernement{{end}}</h3>
  </div><code class="small">{{.ActeID}}</code></div>

  {{if .Cessations}}
  <h4>Il est mis fin aux fonctions de</h4>
  <ul class="tight">{{range .Cessations}}<li>{{if .Fiche}}<a href="{{$root}}/depute/{{.Slug}}/">{{.Nom}}</a>{{else}}{{.Nom}}{{end}} <span class="z small">{{.FonctionFr}}{{if .Portefeuille}}, {{.Portefeuille}}{{end}}</span></li>{{end}}</ul>
  {{end}}

  {{if .Nominations}}
  <h4>Sont nommés</h4>
  <div class="scroll"><table class="pile">
  <thead><tr><th>Fonction</th><th>Nom</th><th>Portefeuille</th><th>Rapproché d'une fiche</th></tr></thead>
  <tbody>{{range .Nominations}}<tr>
    <td class="small z" data-l="Fonction">{{.FonctionFr}}</td>
    <td data-l="Nom">{{if .Fiche}}<a href="{{$root}}/depute/{{.Slug}}/">{{.Nom}}</a>{{else}}{{.Nom}}{{end}}</td>
    <td class="small" data-l="Portefeuille">{{if .Portefeuille}}{{.Portefeuille}}{{else if .Rattachement}}<span class="z">{{.Rattachement}}</span>{{else}}<span class="z">—</span>{{end}}</td>
    <td class="small" data-l="Rapprochement">{{if eq .Statut "CANDIDAT"}}<span class="z">{{if .Fiche}}fiche liée — {{end}}un seul homonyme, non vérifié</span>{{else if eq .Statut "AMBIGU"}}<span class="z">plusieurs homonymes</span>{{else}}<span class="z">aucune fiche</span>{{end}}</td>
  </tr>{{end}}</tbody></table></div>
  {{end}}
</section>
{{end}}
{{end}}

{{/* Les outre-mer, en cartons. Chacun est projeté dans le système légal de son
     territoire, donc dessiné dans son propre repère et À SA PROPRE ÉCHELLE :
     la Guyane fait 84 000 km², la Martinique 1 128, et les mettre à la même
     échelle rendrait l'une invisible. C'est une convention cartographique
     courante, et la page le dit plutôt que de la laisser deviner. */}}
{{define "cartons"}}{{if .}}
<div class="cartons">
  <span class="t">Outre-mer</span>
  {{range .}}<figure class="{{if .Absent}}vide{{end}}">
    {{.SVG}}
    <figcaption>{{.Nom}}<span>{{.Valeur}}</span></figcaption>
  </figure>{{end}}
</div>
<p class="note-cartons">Chaque carton a <strong>sa propre échelle</strong> et sa propre
projection&nbsp;: les surfaces ne se comparent pas d'un carton à l'autre, ni à l'hexagone.</p>
{{end}}{{end}}

{{/* La chaîne de lieux d'un mandat : « commune de Cannes › CA Cannes Pays de
     Lérins › département des Alpes-Maritimes ». Chaque maillon qui a une page
     est un lien ; les autres — un canton, une circonscription — s'affichent
     sans lien, parce que ce site ne leur consacre pas de page. */}}
{{define "lieux"}}{{range $i, $l := .}}{{if $i}}<span class="sep" aria-hidden="true"> › </span>{{end}}<span class="lieu"><span class="ech">{{echelon $l.Type}}</span>&nbsp;{{if $l.URL}}<a href="{{$l.URL}}">{{$l.Nom}}</a>{{else}}{{$l.Nom}}{{end}}</span>{{end}}{{end}}
