{{define "base"}}<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="{{.Root}}/media/logo-mark.svg" type="image/svg+xml">
<title>{{.Title}} — faits-politiques.fr</title>
<link rel="stylesheet" href="{{.Root}}/{{.CSS}}">
<script>
// Appliqué avant le premier rendu : sans cela la page clignote du thème
// système au thème choisi. Trois états — système, clair, sombre — et le choix
// ne quitte jamais le navigateur.
try{var t=localStorage.getItem('fp-theme');
if(t==='dark'||t==='light')document.documentElement.setAttribute('data-theme',t)}catch(e){}
</script>
</head><body>
<a class="saut" href="#contenu">Aller au contenu</a>

<header class="top"><div class="wrap"><div class="row">
  <a class="marque" href="{{.Root}}/">{{marque 30}}<span class="mot">faits-politiques<i>.fr</i></span></a>
  <button type="button" class="rech compact" data-rech hidden>
    {{ico "loupe"}}<span class="txt">Rechercher une personne, un parti…</span><kbd>/</kbd></button>
  <div class="theme" role="group" aria-label="Thème de couleur" hidden>
    <button type="button" data-theme-set="auto" title="Suivre le système"
      aria-label="Suivre le système">{{ico "systeme"}}</button>
    <button type="button" data-theme-set="light" title="Thème clair"
      aria-label="Thème clair">{{ico "soleil"}}</button>
    <button type="button" data-theme-set="dark" title="Thème sombre"
      aria-label="Thème sombre">{{ico "lune"}}</button>
  </div>
  {{/* Ordre : d'abord les chambres, par complétude de la donnée publiée —
       l'Assemblée porte résultats, types de vote, groupes et seuils ; le Sénat
       a plus de bulletins (1,65 M) mais ni résultat ni groupe ; l'Europe ne
       charge que les élus français. Puis l'entrée par sujet, puis les acteurs,
       puis la méthode. Les sources vivent dans « Comprendre » et au pied. */}}
  <nav>
    <a href="{{.Root}}/2027/">{{ico "candidats"}}2027</a>
    <a href="{{.Root}}/assemblee/">{{ico "assemblee"}}Assemblée</a>
    <a href="{{.Root}}/senat/">{{ico "senat"}}Sénat</a>
    <a href="{{.Root}}/europe/">{{ico "europe"}}Europe</a>
    <a href="{{.Root}}/territoires/">{{ico "carte"}}Territoires</a>
    <a href="{{.Root}}/securite/">{{ico "securite"}}Sécurité</a>
    <a href="{{.Root}}/themes/">{{ico "themes"}}Thèmes</a>
    <a href="{{.Root}}/comprendre/">{{ico "comprendre"}}Comprendre</a>
  </nav>
</div></div></header>

{{if .Hero}}<section class="hero">
  <div class="champ" aria-hidden="true"></div>
  <div class="wrap">
    <h1>{{.HeroTitre}}</h1>
    <p class="lede">{{.HeroLede}}</p>
    <div class="outil">
      <button type="button" class="rech grand" data-rech hidden>
        {{ico "loupe"}}<span class="txt">Un nom, un parti, un groupe…</span><kbd>/</kbd></button>
      <div class="suggest">
        <span>Par exemple&nbsp;:</span>
        <a href="{{.Root}}/candidats/">Candidats 2027</a>
        <a href="{{.Root}}/assemblee/">Groupes de l'Assemblée</a>
        <a href="{{.Root}}/partis/">Partis et comptes publics</a>
      </div>
    </div>
    <dl class="ancrage">
      <div><dt>Données arrêtées au</dt><dd>{{.DerniereIngestion}}</dd></div>
      <div><dt>Documents scellés</dt><dd>{{nb .Cov.Documents}}, empreinte SHA-256</dd></div>
      <div><dt>Reconstruction</dt><dd>intégrale depuis l'archive brute</dd></div>
      <div><dt>Vérifier</dt><dd><a href="{{.Root}}/sources/">Sources, licences et dates →</a></dd></div>
    </dl>
  </div>
</section>{{end}}

<main class="wrap" id="contenu">
{{template "content" .}}
</main>

<nav class="tabbar" aria-label="Navigation principale">
  <button type="button" data-rech hidden>{{ico "loupe"}}Chercher</button>
  <a href="{{.Root}}/2027/">{{ico "candidats"}}2027</a>
  <a href="{{.Root}}/assemblee/">{{ico "assemblee"}}Assemblée</a>
  <a href="{{.Root}}/territoires/">{{ico "carte"}}Cartes</a>
  <a href="{{.Root}}/comprendre/">{{ico "comprendre"}}Comprendre</a>
</nav>

<footer class="pied"><div class="wrap">
  <div class="cols">
    <div><h4>Parcourir</h4><ul>
      <li><a href="{{.Root}}/2027/">Présidentielle 2027</a></li>
      <li><a href="{{.Root}}/assemblee/">Assemblée nationale</a></li>
      <li><a href="{{.Root}}/senat/">Sénat</a></li>
      <li><a href="{{.Root}}/territoires/">Territoires</a></li>
      <li><a href="{{.Root}}/securite/">Sécurité</a></li>
      <li><a href="{{.Root}}/europe/">Parlement européen</a></li>
      <li><a href="{{.Root}}/candidats/">Candidats 2027</a></li>
      <li><a href="{{.Root}}/partis/">Partis</a></li>
      <li><a href="{{.Root}}/themes/">Thèmes</a></li>
    </ul></div>
    <div><h4>Comprendre</h4><ul>
      <li><a href="{{.Root}}/comprendre/">Tous les documents de méthode</a></li>
      <li><a href="{{.Root}}/comprendre/perimetre/">Méthode et périmètre</a></li>
      <li><a href="{{.Root}}/comprendre/decisions/">Journal des arbitrages</a></li>
      <li><a href="{{.Root}}/comprendre/charte-graphique/">Charte graphique</a></li>
    </ul></div>
    <div><h4>Vérifier</h4><ul>
      <li><a href="{{.Root}}/sources/">Les {{nb .Cov.Documents}} documents scellés</a></li>
      <li>Code sous AGPL-3.0</li>
      <li>Données sous Licence Ouverte</li>
    </ul></div>
    <div><h4>État du site</h4>
      <p>Données arrêtées au <strong>{{.DerniereIngestion}}</strong>.<br>
      Site reconstruit le {{.BuiltAt}}.</p>
      <p>Le site est régénéré <strong>intégralement</strong> depuis l'archive brute&nbsp;:
      aucune donnée n'est éditée en place.</p></div>
  </div>
  <p class="bas" style="border-top:1px solid var(--filet);margin-top:2rem;padding-top:1.2rem">
    Typographie&nbsp;: IBM&nbsp;Plex Sans et Mono, Newsreader — <abbr title="SIL Open Font License 1.1">OFL&nbsp;1.1</abbr>.
    Icônes&nbsp;: <a href="https://fontawesome.com/license/free" target="_blank" rel="noopener">Font
    Awesome Free 6.7.2</a>, <abbr title="Creative Commons Attribution 4.0">CC&nbsp;BY&nbsp;4.0</abbr>.
    Les trois sont hébergées en propre&nbsp;: ce site ne fait aucune requête vers un tiers.</p>
  <p class="bas" style="border:0;margin-top:0;padding-top:0">Sources primaires&nbsp;:
    {{range $i, $s := .Sources}}{{if $i}} · {{end}}{{$s.Attribution}}{{end}}.
    Dans la limite des licences amont.
    <a href="{{.Root}}/sources/">Le détail, avec dates de consultation et empreintes SHA-256 →</a></p>
</div></footer>

<dialog class="palette" id="palette" aria-label="Rechercher">
  <div class="boite">
    <div class="champ">{{ico "loupe"}}
      <input type="search" id="q" placeholder="Un nom, un parti, un groupe…"
             autocomplete="off" spellcheck="false" aria-label="Rechercher"></div>
    <div class="res" id="res"></div>
    <p class="pied-p" style="margin:0"><strong>Les scrutins ne sont pas encore indexés.</strong>
      L'index couvre les personnes, les partis, les groupes et les référentiels.
      Code de non-couverture&nbsp;: <code>SEARCH_INDEX_PARTIEL</code>.</p>
  </div>
</dialog>

<script src="{{.Root}}/{{.JS}}" defer></script>
</body></html>{{end}}
