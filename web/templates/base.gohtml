{{define "base"}}<!doctype html>
<html lang="fr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" href="{{.Root}}/media/logo-mark.svg" type="image/svg+xml">
<title>{{.Title}} — faits-politiques.fr</title>
<style>
/* Charte : docs/charte-graphique.md
   La couleur n'encode QUE du sens. Les quatre positions de vote sont les seules
   couleurs sémantiques ; l'accent sert aux liens et à rien d'autre. Pas de
   bleu-blanc-rouge : ce site n'est pas officiel et ne doit pas en avoir l'air. */
:root{
  --papier:#FBFAF8; --encre:#16161A; --attenue:#5C5A55; --filet:#E2DED7;
  --carte:#FFFFFF; --accent:#175A6B;
  --pour:#1B6E3C; --contre:#A32A2A; --abst:#8A6510; --absent:#6E6A63;
  --rayon:10px;
}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){
  --papier:#15151A; --encre:#ECEAE5; --attenue:#9C9890; --filet:#2C2C33;
  --carte:#1C1C22; --accent:#66B8CC;
  --pour:#4FBF80; --contre:#E27272; --abst:#D4A73C; --absent:#8F8B83;
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--papier);color:var(--encre);
font:16px/1.62 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
font-variant-numeric:tabular-nums}
.wrap{max-width:70rem;margin:0 auto;padding:0 1.3rem}

header.site{border-bottom:1px solid var(--filet);padding:1.2rem 0 0;margin-bottom:0;
background:var(--carte)}
header.site .marque{display:inline-flex;align-items:center;text-decoration:none;color:inherit}
header.site .marque img{height:50px;width:auto;display:block}
header.site nav{margin-top:1rem;display:flex;gap:.1rem;overflow-x:auto;
scrollbar-width:none;-ms-overflow-style:none}
header.site nav::-webkit-scrollbar{display:none}
header.site .barre{position:relative}
header.site .barre::after{content:"";position:absolute;right:0;top:0;bottom:0;width:2.4rem;
pointer-events:none;background:linear-gradient(to right,transparent,var(--carte));
opacity:0}
@media(max-width:46rem){header.site .barre::after{opacity:1}}
header.site nav a{white-space:nowrap;display:inline-flex;align-items:center;gap:.42rem}
.ico{width:16px;height:16px;flex:0 0 auto;opacity:.78}
header.site nav a:hover .ico{opacity:1}
header.site nav a{font-weight:550;font-size:.94rem;color:var(--attenue);text-decoration:none;
padding:.6rem .9rem;border-bottom:2.5px solid transparent;margin-bottom:-1px;
border-radius:6px 6px 0 0}
header.site nav a:hover{color:var(--encre);border-bottom-color:var(--accent);background:var(--papier)}

/* Bandeau d'ouverture : les chiffres clés en gros — sur un site de données, la
   page d'accueil doit MONTRER les données, pas les décrire.
   Le motif de pointage est confiné à une bande basse et fondu vers le haut :
   en plein cadre il faisait du bruit derrière le texte, ce qui est exactement
   ce qu'une charte « le contenu d'abord » doit interdire. */
.hero{background:var(--carte);border-bottom:1px solid var(--filet);
padding:3.2rem 0 3.4rem;margin-bottom:2.8rem;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;left:0;right:0;top:0;bottom:0;
background-image:url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22220%22%20height%3D%2292%22%3E%3Cg%20fill%3D%22%23808080%22%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2212%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%2220%22%20y%3D%2210.6%22%20width%3D%2246%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2230%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%2220%22%20y%3D%2228.6%22%20width%3D%2232%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2248%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%2220%22%20y%3D%2246.6%22%20width%3D%2254%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2266%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%2220%22%20y%3D%2264.6%22%20width%3D%2238%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%2210%22%20cy%3D%2284%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%2220%22%20y%3D%2282.6%22%20width%3D%2249%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2212%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%22130%22%20y%3D%2210.6%22%20width%3D%2236%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2230%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%22130%22%20y%3D%2228.6%22%20width%3D%2252%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2248%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%22130%22%20y%3D%2246.6%22%20width%3D%2241%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2266%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%22130%22%20y%3D%2264.6%22%20width%3D%2258%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3Ccircle%20cx%3D%22120%22%20cy%3D%2284%22%20r%3D%222.6%22%2F%3E%3Crect%20x%3D%22130%22%20y%3D%2282.6%22%20width%3D%2234%22%20height%3D%222.8%22%20rx%3D%221.4%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E");
background-repeat:repeat;opacity:.04;
-webkit-mask-image:linear-gradient(to left,#000 0%,transparent 34%);
mask-image:linear-gradient(to left,#000 0%,transparent 34%);pointer-events:none}
.hero .wrap{position:relative;z-index:1}
.hero .haut{display:grid;gap:2rem 3rem;align-items:start;
grid-template-columns:minmax(0,1.55fr) minmax(0,1fr)}
.hero h1{font-size:clamp(1.7rem,4.2vw,2.5rem);letter-spacing:-.03em;line-height:1.09;
margin:0 0 1rem;max-width:24ch}
/* Encart de confiance : la date d'arrêt des données et l'accès aux sources
   valent mieux qu'un vide à droite du titre. */
.ancrage{border-left:3px solid var(--accent);padding:.1rem 0 .1rem 1rem;font-size:.9rem}
.ancrage dt{font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;
color:var(--attenue);margin-top:.7rem}
.ancrage dt:first-child{margin-top:0}
.ancrage dd{margin:.1rem 0 0}
.hero .lede{font-size:clamp(.98rem,1.6vw,1.12rem);color:var(--attenue);max-width:54ch;margin:0}

.chiffres{display:grid;gap:1.4rem 1rem;margin-top:2.6rem;
grid-template-columns:repeat(auto-fit,minmax(8.5rem,1fr))}
.chiffre-bloc .v{font-size:clamp(1.5rem,3.4vw,2.05rem);font-weight:700;
letter-spacing:-.035em;line-height:1;white-space:nowrap}
.chiffre-bloc .l{font-size:.73rem;color:var(--attenue);text-transform:uppercase;
letter-spacing:.07em;margin-top:.35rem;display:block;line-height:1.3}

/* Étiquette de section : un surtitre discret au-dessus du titre. */
.eyebrow{font-size:.74rem;text-transform:uppercase;letter-spacing:.09em;
color:var(--accent);font-weight:650;margin-bottom:.25rem}

/* Cartes de section : le chiffre d'abord, la description ensuite. */
.sections{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(15.5rem,1fr));margin:1.6rem 0}
.sec{background:var(--carte);border:1px solid var(--filet);border-radius:var(--rayon);
padding:1.1rem 1.15rem;display:flex;flex-direction:column;gap:.45rem;
text-decoration:none;color:inherit}
.sec:hover{border-color:var(--accent)}
.sec .v{font-size:1.75rem;font-weight:700;letter-spacing:-.025em;line-height:1}
.sec .t{font-weight:650;font-size:1rem}
.sec .d{font-size:.86rem;color:var(--attenue);line-height:1.45}
.sec.vide .v{color:var(--attenue);font-size:1.1rem;font-weight:550}

h1{font-size:1.9rem;line-height:1.22;margin:.2rem 0 .7rem;letter-spacing:-.015em}
h2{font-size:1.32rem;margin:2.8rem 0 .9rem;padding-bottom:.4rem;
border-bottom:2px solid var(--filet);letter-spacing:-.01em}
h3{font-size:1.02rem;margin:1.5rem 0 .4rem}
a{color:var(--accent);text-underline-offset:2px}
a:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:3px}
.lede{color:var(--attenue);font-size:1.04rem;max-width:46rem}
.muted{color:var(--attenue)}.small{font-size:.875rem}

.card{background:var(--carte);border:1px solid var(--filet);border-radius:var(--rayon);
padding:1.05rem 1.15rem;margin:1rem 0}
table{border-collapse:collapse;width:100%;font-size:.93rem}
.scroll{overflow-x:auto}
th,td{text-align:left;padding:.5rem .65rem;border-bottom:1px solid var(--filet);vertical-align:top}
th{font-weight:600;color:var(--attenue);font-size:.76rem;text-transform:uppercase;letter-spacing:.05em}
td:has(+td),.num{font-variant-numeric:tabular-nums}
tbody tr:hover{background:var(--carte)}

.pos{font-weight:650;white-space:nowrap}
.FOR{color:var(--pour)}.AGAINST{color:var(--contre)}.ABSTAIN{color:var(--abst)}
/* Non-votant : désaturé et sans graisse. Ce n'est pas une position politique
   mais une donnée manquante, et son traitement visuel le dit. */
.ABSENT,.NON_VOTING{color:var(--absent);font-weight:400}

.annee{margin:1.8rem 0}
.annee h3{margin-bottom:.4rem}
.jauge{width:150px;height:87px;display:block;color:var(--attenue)}
.poles{display:flex;justify-content:space-between;gap:.6rem;width:150px;
font-size:.7rem;line-height:1.25;text-align:left}
.poles span:last-child{text-align:right}
.bar{display:flex;height:8px;border-radius:4px;overflow:hidden;background:var(--filet);margin:.4rem 0}
.bar i{display:block}
.nodata{border-left:3px solid var(--filet);padding:.15rem 0 .15rem .85rem;color:var(--attenue)}
.warn{border-left:3px solid var(--abst);padding:.55rem 0 .55rem .95rem;margin:1.3rem 0;
color:var(--attenue);font-size:.92rem}
.warn strong{color:var(--encre)}
.grid{display:grid;gap:.9rem;grid-template-columns:repeat(auto-fill,minmax(15rem,1fr))}
.cards{display:grid;gap:1rem;grid-template-columns:repeat(auto-fill,minmax(19rem,1fr));margin:1.5rem 0}
.cand{background:var(--carte);border:1px solid var(--filet);border-radius:var(--rayon);
padding:1rem 1.1rem;display:flex;flex-direction:column;gap:.7rem}
.cand h3{margin:0;font-size:1.05rem}
.cand header.avec-portrait{display:flex;gap:.8rem;align-items:flex-start}
.cand header a{text-decoration:none}
.cand .bilan{flex:1}
.cand .chiffre{font-size:1.55rem;font-weight:650;line-height:1.1;letter-spacing:-.02em}
.cand .bilan.vide{display:flex;flex-direction:column;gap:.4rem;justify-content:center}
.cand .etiquette{display:inline-block;align-self:flex-start;font-size:.78rem;
border:1px solid var(--filet);color:var(--attenue);padding:.18rem .55rem;border-radius:999px}
.cand footer{border-top:1px solid var(--filet);padding-top:.5rem}
.portrait{border-radius:50%;object-fit:cover;flex:0 0 auto;background:var(--filet)}
.portrait.vide{width:64px;height:64px;border-radius:50%;background:var(--filet)}
.entete-portrait{display:flex;gap:1.3rem;align-items:flex-start;margin-bottom:1rem;flex-wrap:wrap}
.entete-portrait img{border-radius:var(--rayon);background:var(--carte);border:1px solid var(--filet)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:.18rem 1.1rem;font-size:.93rem}
.kv dt{color:var(--attenue)}.kv dd{margin:0}
ul.tight{margin:.3rem 0;padding-left:1.1rem}
code{font-size:.85em;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
background:var(--filet);padding:.1em .38em;border-radius:4px}
footer.site{margin:4.5rem 0 0;padding:1.8rem 1.3rem 3rem;border-top:1px solid var(--filet);
background:var(--carte);color:var(--attenue);font-size:.86rem;max-width:none}
footer.site > *{max-width:70rem;margin-left:auto;margin-right:auto}
@media(max-width:46rem){
  .wrap{padding:0 1.1rem}
  h1{font-size:1.45rem}
  h2{font-size:1.15rem;margin-top:2.2rem}
  header.site .marque img{height:42px}
  .hero{padding:2.2rem 0 2.6rem;margin-bottom:2rem}
  .hero::after{opacity:.035;
  -webkit-mask-image:linear-gradient(to top,#000 0%,transparent 55%);
  mask-image:linear-gradient(to top,#000 0%,transparent 55%)}
  .hero .haut{grid-template-columns:1fr;gap:1.5rem}
  .ancrage{border-left:none;border-top:2px solid var(--filet);padding:.9rem 0 0;
  display:grid;grid-template-columns:auto 1fr;gap:.15rem .9rem;align-items:baseline}
  .ancrage dt{margin-top:0}
  .chiffres{gap:1.1rem .9rem;margin-top:1.8rem;grid-template-columns:repeat(2,1fr)}
  .sections{grid-template-columns:1fr}
  table{font-size:.87rem}
  th,td{padding:.45rem .5rem}
}
</style></head><body>
<header class="site"><div class="wrap">
<a class="marque" href="{{.Root}}/"><img src="{{.Root}}/media/logo.svg"
  alt="faits-politiques.fr — ce qui a été voté, décidé, proposé"></a>
<div class="barre"><nav>
  <a href="{{.Root}}/candidats/">{{ico "candidats"}}Candidats</a>
  <a href="{{.Root}}/partis/">{{ico "partis"}}Partis</a>
  <a href="{{.Root}}/assemblee/">{{ico "assemblee"}}Assemblée</a>
  <a href="{{.Root}}/senat/">{{ico "senat"}}Sénat</a>
  <a href="{{.Root}}/europe/">{{ico "europe"}}Europe</a>
  <a href="{{.Root}}/themes/">{{ico "themes"}}Thèmes</a>
  <a href="{{.Root}}/sources/">{{ico "sources"}}Sources</a>
</nav></div>
</div></header>
{{if .Hero}}<section class="hero"><div class="wrap">
  <div class="haut">
    <div>
      <h1>{{.HeroTitre}}</h1>
      <p class="lede">{{.HeroLede}}</p>
    </div>
    <dl class="ancrage">
      <dt>Données arrêtées au</dt><dd>{{.DerniereIngestion}}</dd>
      <dt>Documents scellés</dt><dd>{{nb .Cov.Documents}}, identifiés par leur empreinte SHA-256</dd>
      <dt>Vérifier</dt><dd><a href="{{.Root}}/sources/">Toutes les sources, licences et dates</a></dd>
    </dl>
  </div>
  <div class="chiffres">
    <div class="chiffre-bloc"><div class="v">{{nb .Cov.Scrutins}}</div><span class="l">scrutins à l'Assemblée</span></div>
    <div class="chiffre-bloc"><div class="v">{{nb .Cov.Ballots}}</div><span class="l">votes à l'Assemblée</span></div>
    <div class="chiffre-bloc"><div class="v">{{nb .Cov.Deputes}}</div><span class="l">députés</span></div>
    <div class="chiffre-bloc"><div class="v">{{nb .Cov.Dossiers}}</div><span class="l">dossiers législatifs</span></div>
    <div class="chiffre-bloc"><div class="v">{{nb .Cov.ScrutinsPE}}</div><span class="l">scrutins européens</span></div>
  </div>
</div></section>{{end}}
<main class="wrap">
{{template "content" .}}
</main>
<footer class="site">
<p><strong>Sources.</strong> {{range .Sources}}{{.Attribution}} — {{.Label}},
consulté le {{.Fetched}}, empreinte <code>{{.SHA}}</code>.<br>{{end}}</p>
<p>Site reconstruit intégralement à partir des données brutes archivées.
Généré le {{.BuiltAt}}. Méthode et périmètre : <code>docs/perimetre.md</code>.</p>
</footer></body></html>{{end}}
