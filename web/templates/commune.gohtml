{{define "content"}}
{{$c := .C}}
<p class="fil"><a href="{{.Root}}/">Accueil</a> ›
  <a href="{{.Root}}/collectivites/">Collectivités</a>
  {{if $c.Region.Name}} › {{if $c.Region.URL}}<a href="{{$c.Region.URL}}">{{$c.Region.Name}}</a>{{else}}{{$c.Region.Name}}{{end}}{{end}}
  {{if $c.Dept.Name}} › {{if $c.Dept.URL}}<a href="{{$c.Dept.URL}}">{{$c.Dept.Name}}</a>{{else}}{{$c.Dept.Name}}{{end}}{{end}}
  › <span>{{$c.Name}}</span></p>
<span class="sur">Commune · code INSEE {{$c.Code}}</span>
<h1>{{$c.Name}}</h1>
<p class="lede">{{if $c.Population}}{{nb $c.Population}} habitants{{else}}Population non publiée{{end}}{{if $c.Dept.Name}},
{{if $c.Dept.URL}}<a href="{{$c.Dept.URL}}">{{$c.Dept.Name}}</a>{{else}}{{$c.Dept.Name}}{{end}}{{end}}{{if $c.EPCI}}. Membre de
{{if $c.EPCI.URL}}<a href="{{$c.EPCI.URL}}">{{$c.EPCI.Name}}</a>{{else}}{{$c.EPCI.Name}}{{end}}{{if $c.NatureEPCI}} <span class="z">({{lower $c.NatureEPCI}})</span>{{end}}{{end}}.</p>

{{template "situation" $c.Situation}}

<h2>Le conseil municipal</h2>
{{if $c.Mayor}}
<div class="cartes trois">
  <div class="carte"><span class="v" style="font-size:1.25rem">{{if $c.Mayor.Profile}}<a href="{{$.Root}}/depute/{{$c.Mayor.Slug}}/">{{$c.Mayor.Name}}</a>{{else}}{{$c.Mayor.Name}}{{end}}</span>
    <span class="t">Maire</span>
    <span class="d">Depuis le {{$c.Mayor.Depuis}}. Élu par le conseil municipal, pas au suffrage
      universel direct.</span></div>
  <div class="carte"><span class="v">{{$c.CountCouncillors}}</span><span class="t">Conseillers municipaux</span>
    <span class="d">En fonction selon le répertoire national des élus, maire compris.</span></div>
</div>
{{else}}<p class="nodata">Le répertoire national des élus ne publie pas de maire en fonction pour cette
commune.</p>{{end}}

{{if $c.Elected}}
<details class="plus"{{if le (len $c.Elected) 12}} open{{end}}>
  <summary>Les {{len $c.Elected}} autres membres du conseil</summary>
  <div class="dedans">
  <div class="scroll"><table class="pile">
  <thead><tr><th>Nom</th><th>Fonction</th><th>Depuis</th></tr></thead>
  <tbody>{{range $c.Elected}}<tr>
    <td>{{if .Profile}}<a href="{{$.Root}}/depute/{{.Slug}}/">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td>
    <td class="small z" data-l="Fonction">{{if .Function}}{{.Function}}{{else}}conseiller{{end}}</td>
    <td class="small z" data-l="Depuis">{{.Depuis}}</td>
  </tr>{{end}}</tbody></table></div>
  </div>
</details>
{{end}}

{{if $c.Lists}}
<h2>Municipales, {{if eq $c.RoundFinal 2}}second tour{{else}}premier tour{{end}}</h2>
<div class="scroll"><table>
<thead><tr><th>Liste</th><th>Nuance</th><th class="n">Voix</th><th class="n">Part</th><th class="n">Sièges</th></tr></thead>
<tbody>{{range $c.Lists}}<tr>
  <td class="small">{{.Label}}</td>
  <td class="small z">{{if .Nuance}}<code>{{.Nuance}}</code>{{else}}—{{end}}</td>
  <td class="n">{{nb .Votes}}</td><td class="n">{{dec .Pct 1}} %</td>
  <td class="n">{{if .Seats}}{{.Seats}}{{else}}<span class="z">0</span>{{end}}</td>
</tr>{{end}}</tbody></table></div>
{{if $c.ListsT1}}
<details class="plus">
  <summary>Le premier tour ({{len $c.ListsT1}} listes)</summary>
  <div class="dedans"><div class="scroll"><table>
  <thead><tr><th>Liste</th><th>Nuance</th><th class="n">Voix</th><th class="n">Part</th></tr></thead>
  <tbody>{{range $c.ListsT1}}<tr>
    <td class="small">{{.Label}}</td>
    <td class="small z">{{if .Nuance}}<code>{{.Nuance}}</code>{{else}}—{{end}}</td>
    <td class="n">{{nb .Votes}}</td><td class="n">{{dec .Pct 1}} %</td>
  </tr>{{end}}</tbody></table></div></div>
</details>
{{end}}
<p class="note">Une nuance est attribuée à chaque liste par la préfecture&nbsp;; ce n'est pas une
adhésion déclarée. Les sièges sont ceux du conseil municipal, attribués au tour décisif.</p>
{{else}}
<p class="note abs">Aucune liste n'est publiée pour cette commune. Sous 1 000 habitants jusqu'en 2020,
le scrutin était plurinominal et ne produisait pas de résultats par liste&nbsp;; la source n'en porte
donc pas.</p>
{{end}}

{{if $c.Finances}}
<h2>Finances, exercice {{$c.YearFinances}}</h2>
<div class="scroll"><table>
<thead><tr><th>Indicateur</th><th class="n">Par habitant</th><th class="n">Médiane des communes de même taille</th></tr></thead>
<tbody>{{range $c.Finances}}<tr>
  <td>{{.Label}}</td><td class="n">{{.Value}}</td><td class="n z">{{.Median}}</td>
</tr>{{end}}</tbody></table></div>
<p class="note">La comparaison est faite avec les communes de la même strate de population&nbsp;: une
médiane toutes communes confondues rapprocherait une métropole d'un village. Un écart ne dit rien
d'une bonne ou d'une mauvaise gestion — il dépend d'abord de ce que la commune gère en propre plutôt
que par son intercommunalité.</p>
{{end}}

{{if $c.Security}}
<h2>Faits enregistrés, {{$c.YearSecurity}}</h2>
<div class="scroll"><table>
<thead><tr><th>Indicateur</th><th class="n">Faits</th><th class="n">Pour 1 000 habitants</th></tr></thead>
<tbody>{{range $c.Security}}<tr>
  <td class="small">{{.Label}}</td>
  {{if .Mask}}<td colspan="2" class="n small z">non diffusé par le SSMSI — trop peu de faits pour publier sans identifier</td>
  {{else}}<td class="n">{{.Count}}</td><td class="n">{{.Rate}}</td>{{end}}
</tr>{{end}}</tbody></table></div>
<p class="note">Des faits <strong>enregistrés</strong> par la police et la gendarmerie, pas des faits
commis. Rapportés à la population résidente, pas à la population présente.
<a href="{{.Root}}/securite/">La carte par département →</a></p>
{{end}}

{{if $c.Associations}}
<p class="note proc"><strong>{{nb $c.Associations}} associations</strong> déclarées dans cette commune
au répertoire national des associations — qui n'enregistre pas toujours les dissolutions.</p>
{{end}}

<p class="src">Élus&nbsp;: répertoire national des élus. Finances&nbsp;: OFGL. Faits enregistrés&nbsp;:
SSMSI. Municipales&nbsp;: ministère de l'Intérieur. Intercommunalité&nbsp;: base nationale sur les
intercommunalités.</p>
{{end}}
